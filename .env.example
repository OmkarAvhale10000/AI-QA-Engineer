# Environment Variables for AI QA Engineer Platform
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for agent reasoning)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Agent Backend Server Port
AGENT_PORT=3001

# Benchmark App Port
BENCHMARK_PORT=5174

# Dashboard Port  
DASHBOARD_PORT=5173
